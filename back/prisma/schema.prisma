// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum blood_type_enum {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum type_product_sale_enum {
  P
  M
}

enum transaction_type_enum {
  INCOME
  EXPENSE
}

enum transaction_category_enum {
  SALE
  SUPPLIER_PAYMENT
  MISC_EXPENSE
}

model Gender {
  company_id     Int
  branch_id      Int
  name           String @id  @db.VarChar(2)
  description    String   @db.VarChar(40)
  status         Int @default(1)
  created_date   DateTime  
  modified_date  DateTime? 
  created_by     String? @db.VarChar(100)
  modified_by    String?  @db.VarChar(100)

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  clients  Client[]
  @@unique([company_id, branch_id, name])
  @@map("gender")
}

model IdType {
  company_id     Int 
  branch_id      Int
  name            String @id  @db.VarChar(4)
  description     String   @db.VarChar(40)
  status          Int @default(1)
  created_date    DateTime  
  modified_date   DateTime? 
  created_by      String? @db.VarChar(100)
  modified_by     String? @db.VarChar(100)

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  clients  Client[]
  @@unique([company_id, branch_id, name])
  @@map("id_type")
}

model Client {
  company_id     Int 
  branch_id      Int
  identification_number String @id @db.VarChar(20)
  first_name     String   @db.VarChar(30)
  last_name      String   @db.VarChar(30)
  email          String?  @unique @db.VarChar(100)
  phone_number   String?  @db.VarChar(20)
  birth_day      DateTime 
  gender_id      String @db.VarChar(2) 
  height         Float
  weight         Float
  blood_type     blood_type_enum
  type_id        String @db.VarChar(4)
  address        String?  @db.VarChar(200)
  fingerprint    Bytes? 
  status         Int       @default(1)
  created_date   DateTime 
  modified_date  DateTime?
  created_by     String? @db.VarChar(100)
  modified_by    String?  @db.VarChar(100)

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  gender   Gender   @relation(fields: [company_id, branch_id, gender_id], references: [company_id, branch_id, name])
  id_type  IdType   @relation(fields: [company_id, branch_id, type_id], references: [company_id, branch_id, name])
  sales Sale[]
  client_membership ClientMembership[]

  @@unique([company_id, branch_id, identification_number])
  @@map("client")
}

model User {
  company_id     Int 
  branch_id      Int
  email         String @id  @db.VarChar(100)
  password      String   @db.VarChar(100)
  first_name     String   @db.VarChar(30)
  last_name      String   @db.VarChar(30)
  phone_number   String?  @db.VarChar(20)
  status        Int      @default(1)
  created_date   DateTime 
  modified_date  DateTime? 
  created_by     String?  @db.VarChar(100)
  modified_by    String?  @db.VarChar(100)

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  roles         UserRole[]
  cash_register         CashRegister[]
  user_cash_register         UserCashRegister[]
  
  @@unique([company_id, branch_id, email])
  @@map("user")
}

model Role {
  company_id     Int 
  branch_id      Int
  role          String  @id @db.VarChar(20)
  description   String?  @db.VarChar(60)
  status        Int      @default(1)
  created_date   DateTime 
  modified_date  DateTime? 
  created_by     String?  @db.VarChar(100)
  modified_by    String?  @db.VarChar(100)

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  users         UserRole[]
  
  @@unique([company_id, branch_id, role])
  @@map("role")
}

model UserRole {
  company_id     Int 
  branch_id      Int
  id             Int   @id @default(autoincrement())
  user_email     String   @db.VarChar(100)
  role_name      String   @db.VarChar(20)
  status        Int      @default(1)
  created_date   DateTime 
  modified_date  DateTime? 
  created_by     String?  @db.VarChar(100)
  modified_by    String?  @db.VarChar(100)

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  user          User     @relation(fields: [company_id, branch_id, user_email], references: [company_id, branch_id, email])
  role          Role     @relation(fields: [company_id, branch_id, role_name], references: [company_id, branch_id, role])

  @@unique([company_id, branch_id, user_email, role_name]) 
  @@map("user_role")// un usuario no puede tener el mismo rol dos veces
}

model Branch {
  company_id     Int 
  branch_id    Int
  address      String   @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  status       Int      @default(1)
  created_date  DateTime 
  modified_date DateTime? 
  created_by    String?  @db.VarChar(100)
  modified_by   String?  @db.VarChar(100)

  company  Company   @relation(fields: [company_id], references: [id])
  genders         Gender[]
  idTypes         IdType[]
  clients         Client[]
  users           User[]
  roles           Role[]
  userRoles       UserRole[]
  products        Product[]
  categories      Category[]
  sales           Sale[]
  saleItems       SaleItem[]
  memberships     Membership[]
  client_membership ClientMembership[]
  cash_box CashBox[]
  cash_register CashRegister[]
  cash_register_transaction CashRegisterTransaction[]
  user_cash_register UserCashRegister[]
  
  @@unique([company_id, branch_id]) 
  @@map("branch")
}

model Company {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  status       Int      @default(1)
  created_date  DateTime 
  modified_date DateTime? 
  created_by    String?  @db.VarChar(100)
  modified_by   String?  @db.VarChar(100)

  branches        Branch[]
  genders         Gender[]
  idTypes         IdType[]
  clients         Client[]
  users           User[]
  roles           Role[]
  userRoles       UserRole[]
  products        Product[]
  categories      Category[]
  sales           Sale[]
  saleItems       SaleItem[]
  memberships     Membership[]
  client_membership ClientMembership[]
  cash_box CashBox[]
  cash_register CashRegister[]
  cash_register_transaction CashRegisterTransaction[]
  user_cash_register UserCashRegister[]
  
  @@map("company")
}

model Product {
  company_id     Int 
  branch_id      Int
  id             Int   @id 
  barcode        String @db.VarChar(200)
  product_name   String     @db.VarChar(150)
  description   String?    @db.VarChar(255)
  stock         Int        @default(0)
  category_id    Int
  status        Int        @default(1)
  created_date   DateTime   
  modified_date  DateTime?   
  created_by     String?    @db.VarChar(100)
  modified_by    String?    @db.VarChar(100)

  // Relaciones
  category      Category   @relation(fields: [company_id, branch_id, category_id], references: [company_id, branch_id, id])
  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  saleItems     SaleItem[]
  
  @@unique([company_id, branch_id, id]) 
  @@map("product")
}

model Category {
  company_id     Int 
  branch_id      Int
  id            Int        @id 
  name          String     @db.VarChar(100)
  status        Int        @default(1)
  created_date   DateTime   
  modified_date  DateTime?   
  created_by     String?    @db.VarChar(100)
  modified_by    String?    @db.VarChar(100)

  // Relaciones
  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  products      Product[]

  @@unique([company_id, branch_id, id]) 
  @@map("category")
}

model Sale {
  company_id     Int 
  branch_id      Int
  id            Int        @id 
  client_id      String     @db.VarChar(20)
  total         Float      @default(0)
  totalDiscount Float      @default(0)
  status        Int        @default(1)
  created_date   DateTime  
  created_by     String?    @db.VarChar(100)

  @@unique([company_id, branch_id, id])

  // Relaciones
  client        Client     @relation(fields: [company_id, branch_id, client_id], references: [company_id, branch_id, identification_number])
  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  items         SaleItem[]
  
  @@map("sale")
}

model SaleItem {
  company_id     Int 
  branch_id      Int
  sale_id        Int
  item_id        Int
  type_sale      type_product_sale_enum
  product_id     Int?
  membership_id  Int?
  price         Float
  quantity      Int
  discount      Float?     @default(0)
  created_date   DateTime   
  created_by     String?    @db.VarChar(100)

  // Relaciones
  sale          Sale       @relation(fields: [company_id, branch_id, sale_id], references: [company_id, branch_id, id])
  product       Product?    @relation(fields: [company_id, branch_id, product_id], references: [company_id, branch_id, id])
  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  membership  Membership?   @relation(fields: [company_id, branch_id, membership_id], references: [company_id, branch_id, id])
  @@unique([company_id, branch_id, sale_id, item_id])
  @@map("sale_item")
}

model Membership {
  company_id     Int 
  branch_id      Int
  id             Int @id 
  name           String @db.VarChar(30)
  description    String
  status         Int
  price          Float
  duration       Int
  created_date   DateTime  @default(now())
  modified_date  DateTime? @updatedAt
  created_by     String?
  modified_by    String?

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  client_membership ClientMembership[]
  sales SaleItem[]

  @@unique([company_id, branch_id, id]) 
  @@map("membership")
}

model ClientMembership {
  company_id     Int 
  branch_id      Int
  id             Int       @id @default(autoincrement())
  client_id      String   @db.VarChar(20)
  membership_id  Int
  start_date     DateTime
  end_date       DateTime
  status         Int
  created_date   DateTime  @default(now())
  modified_date  DateTime? @updatedAt
  created_by     String?
  modified_by    String?

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  membership     Membership @relation(fields: [company_id, branch_id, membership_id], references: [company_id, branch_id, id])
  client         Client @relation(fields: [company_id, branch_id, client_id], references: [company_id, branch_id, identification_number])

  @@unique([company_id, branch_id, client_id, membership_id]) 
  @@map("client_membership")
}

model CashBox {
  company_id Int
  branch_id Int
  id Int @id @default(autoincrement())
  name String @db.VarChar(100)
  status Int
  created_date   DateTime  @default(now())
  modified_date  DateTime? @updatedAt
  created_by     String?
  modified_by    String?

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])

  cash_register CashRegister[]
  cash_register_transaction CashRegisterTransaction[]
  user_cash_register UserCashRegister[]

  @@unique([company_id, branch_id, id])
  @@map("cash_box")
}

model CashRegister {
  company_id Int
  branch_id Int
  cash_box_id Int
  id Int 
  user_email String @db.VarChar(100)
  initial_amount Float
  theoretical_amount Float
  final_amount Float
  diference Float
  opened_at DateTime
  closed_at DateTime?
  observations String @db.VarChar(255)
  status Int
  created_date   DateTime  @default(now())
  modified_date  DateTime? @updatedAt
  created_by     String?
  modified_by    String?

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  cash_box  CashBox   @relation(fields: [company_id, branch_id, cash_box_id], references: [company_id, branch_id, id])
  user User @relation(fields: [company_id, branch_id, user_email], references: [company_id, branch_id, email])

  transactions CashRegisterTransaction[]
  @@unique([company_id, branch_id, cash_box_id, id])
  @@map("cash_register")
}

model CashRegisterTransaction {
  company_id Int
  branch_id Int
  cash_box_id Int
  cash_register_id Int
  consec Int 
  type transaction_type_enum
  category transaction_category_enum
  amount Float
  description String @db.VarChar(255)
  created_date   DateTime  @default(now())
  created_by     String

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  cash_box  CashBox   @relation(fields: [company_id, branch_id, cash_box_id], references: [company_id, branch_id, id])
  cash_register  CashRegister   @relation(fields: [company_id, branch_id, cash_box_id, cash_register_id], references: [company_id, branch_id, cash_box_id, id], map: "cash_reg_trans_companyid_branchid_cashboxid_cashregid_fkey")
  @@unique([company_id, branch_id, cash_box_id, cash_register_id, consec])
  @@map("cash_register_transaction")
}

model UserCashRegister {
  company_id Int
  branch_id Int
  cash_box_id Int
  user_email String @db.VarChar(100)
  status Int
  created_date   DateTime  @default(now())
  modified_date  DateTime? @updatedAt
  created_by     String?
  modified_by    String?

  company  Company   @relation(fields: [company_id], references: [id])
  branch  Branch   @relation(fields: [company_id, branch_id], references: [company_id, branch_id])
  cash_box  CashBox   @relation(fields: [company_id, branch_id, cash_box_id], references: [company_id, branch_id, id])
  user User @relation(fields: [company_id, branch_id, user_email], references: [company_id, branch_id, email])
  @@unique([company_id, branch_id, cash_box_id, user_email])
  @@map("user_cash_register")
}